{
  "tasks": {
    "generate": {
      "inputs": [
        "host/native/**",
        "ui/preview/**",
        "scripts/generate.mjs",
        "package.json"
      ],
      "outputs": [
        "generated/**",
        "host/native/build/**"
      ],
      "cache": false
    },
    "build": {
      "dependsOn": [
        "generate"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "test": {
      "dependsOn": [
        "generate"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "generate"
      ]
    },
    "smoke": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    }
  },
  "$schema": "https://turbo.build/schema.json"
}
